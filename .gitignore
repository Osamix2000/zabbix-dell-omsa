# ==============================================================================
# Dell OMSA Zabbix Template
# Gitで管理しないローカルファイル・機密情報
# ==============================================================================

# --- SSH ---------------------------------------------------------------
# .ssh / .SSH / .Ssh 等、大文字小文字を問わず除外する。
# 末尾の*により .ssh_backup / .SSH-old 等も対象になる。
.[sS][sS][hH]
.[sS][sS][hH]*

# --- 環境変数・機密情報 ------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# SSH秘密鍵がリポジトリ直下等へ置かれた場合の保険
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*

# --- OS生成ファイル ----------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# --- エディタ・IDE ------------------------------------------------------
*~
*.swp
*.swo
*.tmp
*.bak
*.orig
*.rej
.vscode/
.idea/
*.code-workspace

# --- ログ・PID・キャッシュ --------------------------------------------
*.log
*.pid
*.cache
.cache/
tmp/
temp/

# --- テスト・解析で生成する一時成果物 ----------------------------------
coverage/
.coverage

# --- 配布・圧縮・パッケージ成果物 --------------------------------------
# GitHub Releases等へ添付する成果物はGitリポジトリには含めない。
*.zip
*.tar
*.tar.gz
*.tgz
*.deb
*.rpm

# --- ローカルバックアップ ----------------------------------------------
*.backup
*.bk
*.old
